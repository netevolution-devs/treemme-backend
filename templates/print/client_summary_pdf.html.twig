<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Riepilogo Clienti</title>
    <style>
        @page { size: A4 landscape; margin: 1cm; }
        body { font-family: Arial, sans-serif; font-size: 9pt; color: #333; margin: 0; }
        .page { page-break-after: always; padding: 10px; }
        .page:last-child { page-break-after: avoid; }
        h1 { font-size: 14pt; margin-bottom: 15px; text-align: center; border-bottom: 1px solid #000; padding-bottom: 5px; text-transform: uppercase; }
        
        .client-section { margin-bottom: 20px; width: 100%; border-collapse: collapse; }
        .client-info-table { width: 100%; margin-bottom: 10px; border: 1px solid #000; }
        .client-info-table td { padding: 5px; vertical-align: top; border: 1px solid #ccc; }
        .label { font-weight: bold; font-size: 8pt; color: #555; text-transform: uppercase; display: block; margin-bottom: 2px; }
        
        .order-container { margin-bottom: 20px; }
        .order-header { background-color: #f2f2f2; padding: 5px; border: 1px solid #000; font-weight: bold; margin-bottom: 0; }
        
        .rows-table { width: 100%; border-collapse: collapse; border: 1px solid #000; }
        .rows-table th { background-color: #e6e6e6; border: 1px solid #000; padding: 4px; text-align: left; font-size: 8pt; }
        .rows-table td { border: 1px solid #000; padding: 4px; vertical-align: top; }
        
        .row-secondary { font-size: 8pt; background-color: #fafafa; }
        .ok-status { color: green; }
        .not-ok-status { color: red; }
        .text-right { text-align: right; }
        .text-center { text-align: center; }
        .bg-light { background-color: #f9f9f9; }
    </style>
</head>
<body>
    {% for clientGroup in data %}
    <div class="page">
        <h1>Riepilogo Clienti</h1>
        
        <table class="client-info-table">
            <tr>
                <td style="width: 40%;">
                    <span class="label">Cliente:</span>
                    <strong style="font-size: 11pt;">{{ clientGroup.client.name }}</strong>
                </td>
                <td style="width: 35%;">
                    <span class="label">Sede/Destinazione Principale:</span>
                    {% if clientGroup.firstAddress %}
                        {{ clientGroup.firstAddress.address }}<br>
                        {{ clientGroup.firstAddress.zip_code }} {{ clientGroup.firstAddress.address_name }}
                    {% else %}
                        -
                    {% endif %}
                </td>
                <td style="width: 25%;">
                    <span class="label">Agente Associato:</span>
                    {% if clientGroup.firstAgent %}
                        {{ clientGroup.firstAgent.name }}
                    {% else %}
                        -
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td style="width: 40%;">
                    <span class="label">Pagamento:</span>
                    {{ clientGroup.client.payment.name|default('-') }}
                </td>
                <td style="width: 35%;">
                    <span class="label">Resa (Spedizione):</span>
                    {{ clientGroup.client.shipment_condition.name|default('-') }}
                </td>
                <td style="width: 25%;">
                    <span class="label">Note Cliente:</span>
                    {{ clientGroup.client.client_note|default('-') }}
                </td>
            </tr>
        </table>

        {% for order in clientGroup.orders %}
        <div class="order-container">
            <div class="order-header">
                <span class="{{ order.details.checked ? 'ok-status' : 'not-ok-status' }}">{{ order.details.checked ? 'OK' : 'KO' }}</span> | {{ order.details.order_number }} DEL {{ order.details.order_date|date('d/m/Y') }}
                | RIF CLT: {{ order.details.client_order_number ?: '-' }} DEL {{ order.details.client_order_date ? order.details.client_order_date|date('d/m/Y') : '-' }} | NOTE AMM: {{ order.details.order_note_administration ? order.details.order_note_administration : '-'}}
            </div>
            <table class="rows-table">
                <tbody>
                    {% for row in order.rows %}
                    <tr>
                        <td>{{ row.weight }}  {{ row.article.client_code ? row.article.client_code : row.article.code }} <br>
                         Note amm {{ row.administration_row_note }}</td>
                        <td>
                            <strong>{{ row.article.name }}</strong>
                            {% if row.administration_row_note %}
                                <div style="margin-top: 4px; font-style: italic; font-size: 8pt; color: #666;">
                                    Note: {{ row.administration_row_note }}
                                </div>
                            {% endif %}
                        </td>
                        <td class="text-right">{{ row.quantity|number_format(2, ',', '.') }}</td>
                        <td class="text-center">{{ row.measurement_unit.name }}</td>
                        <td class="text-right">{{ row.price|number_format(2, ',', '.') }}€</td>
                        <td class="row-secondary">
                            {% if row.ddt_row %}
                                <div style="margin-bottom: 3px; font-weight: bold; color: #0056b3;">
                                    DDT: {{ row.ddt_row.ddt.ddt_number }} del {{ row.ddt_row.ddt.ddt_date|date('d/m/Y') }} (Qta: {{ row.ddt_row.quantity }})
                                </div>
                            {% endif %}
                            
                            {% if row.address %}
                                <div style="font-size: 7.5pt; color: #444;">
                                    Dest. Alt: {{ row.address.address }}, {{ row.address.zip_code }} {{ row.address.address_name }}
                                </div>
                            {% endif %}
                            
                            {% if not row.ddt_row and not row.address %}
                                -
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endfor %}
    </div>
    {% endfor %}
</body>
</html>

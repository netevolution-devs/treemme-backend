<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Batch PDF</title>
    <style>
        @page {
            margin: 1.5cm 1cm 1cm 1cm;
        }

        body {
            font-family: 'Verdana', sans-serif;
            font-size: 21px;
            line-height: 1.4;
            color: #000;
            text-transform: uppercase;
        }

        .info-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .info-table td {
            border: 1px solid #000;
            padding: 10px;
            text-align: left;
            vertical-align: middle;
        }

        .header-cell {
            font-weight: bold;
        }

        .bold {
            font-weight: bold;
        }

        .center {
            text-align: center;
        }
    </style>
</head>
<body>
<table class="info-table">
    {# Intestazione #}
    <tr style="font-size: 14px;">
        <td class="bold center header-cell">Conceria 3 Emme</td>
        <td class="bold center">Sistema Qualità</td>
        <td class="bold center">Tipo: MOD PARTITE</td>
        <td class="bold center">DOC REV 1</td>
    </tr>

    {# batch_code e pieces #}
    <tr>
        <td colspan="2" class="bold center" style="text-align: center; font-size: 100px;">
            {{ batch.batchCode }}
        </td>
        <td colspan="2" class="bold center" style="text-align: center; font-size: 90px;">
            {{ batch.pieces }}
        </td>
    </tr>

    {# Data Consegna #}
    <tr>
        <td colspan="4">
            <span style="font-weight: bold;">Data Consegna:</span> {{ batch.batchDate ? batch.batchDate|date('d/m/Y') : '' }}
        </td>
    </tr>

    {# Pellame o Articolo #}
    <tr>
        <td colspan="4" ">
            {% if batch.article %}
                {{ batch.article.name }}
            {% elseif batch.leather %}
                {{ batch.leather.name }}
            {% else %}
                N/A
            {% endif %}
        </td>
    </tr>
    {# Note #}
    <tr>
        <td colspan="4">
            <span style="font-weight: bold;">Note:</span>{{ batch.batchNote }}
        </td>
    </tr>
    {# Scortico #}
    <tr>
        <td colspan="4">
            <span style="font-weight: bold;">Scortico:</span> {{ (batch.leather and batch.leather.flay) ? batch.leather.flay.name : 'N/A' }}
        </td>
    </tr>
    {# Dati BatchData (KG LORDI, Pallets, Tara, KG NETTI) #}
    {% set firstBatchData = batch.batchData|first %}
    <tr style="font-size: 14px;">
        <td colspan="4" style="padding: 0;">
            <table style="width: 100%; border-collapse: collapse; border: none;">
                <tr>
                    <td style="border: none; border-right: 1px solid #000; padding: 3px; width: 25%;"><span class="bold">KG LORDI</span> {{ firstBatchData ? firstBatchData.foundedGrossWeight|number_format(2, ',', '.') : '' }}</td>
                    <td style="border: none; border-right: 1px solid #000; padding: 3px; width: 25%;"><span class="bold">Pallets</span> {{ firstBatchData ? firstBatchData.palletNumber : '' }}</td>
                    <td style="border: none; border-right: 1px solid #000; padding: 3px; width: 20%;"><span class="bold">Tara</span> {{ firstBatchData ? firstBatchData.palletWeight|number_format(2, ',', '.') : '' }}</td>
                    <td style="border: none; padding: 3px; width: 30%;">
                        <span class="bold">KG NETTI</span>
                        <span style="float: right;" class="bold">{{ firstBatchData ? firstBatchData.foundedNetWeight|number_format(2, ',', '.') : '' }}</span>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>

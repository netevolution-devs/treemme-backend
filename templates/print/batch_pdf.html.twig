<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Batch PDF</title>
    <style>
        body {
            font-family: 'Verdana', sans-serif;
            font-size: 24px;
            line-height: 1.4;
            color: #000;
            text-transform: uppercase;
        }

        .info-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .info-table td {
            border: 1px solid #000;
            padding: 3px;
            text-align: left;
            vertical-align: middle;
        }

        .header-cell {
            font-weight: bold;
        }

        .bold {
            font-weight: bold;
        }

        .center {
            text-align: center;
        }
    </style>
</head>
<body>
<table class="info-table">
    {# Intestazione #}
    <tr style="font-size: 14px;">
        <td class="center header-cell">Conceria Tre Emme</td>
        <td class="center">Sistema Qualità</td>
        <td class="center"><span
                    style="font-weight: bold;">Tipo:</span> {{ batch.batchType ? batch.batchType.name : 'N/A' }}</td>
        <td class="center">rev 1</td>
    </tr>

    {# batch_code e pieces #}
    <tr>
        <td colspan="3" class="bold center" style="text-align: center; font-size: 100px;">
            {{ batch.batchCode }}
        </td>
        <td colspan="1" class="bold center" style="text-align: center; font-size: 90px;">
            {{ batch.pieces }}
        </td>
    </tr>

    {# Data Consegna #}
    <tr>
        <td colspan="4">
            <span style="font-weight: bold;">Data Consegna:</span> {{ batch.batchDate ? batch.batchDate|date('d/m/Y') : '' }}
        </td>
    </tr>

    {# Pellame o Articolo #}
    <tr>
        <td colspan="4">
            {% if batch.article %}
                {{ batch.article.name }}
            {% elseif batch.leather %}
                {{ batch.leather.name }}
            {% else %}
                N/A
            {% endif %}
        </td>
    </tr>
    {# Note #}
    <tr>
        <td colspan="4">
            <span style="font-weight: bold;">Note:</span>{{ batch.batchNote }}
        </td>
    </tr>
    {# Scortico #}
    <tr>
        <td colspan="4">
            <span style="font-weight: bold;">Scortico:</span> {{ (batch.leather and batch.leather.flay) ? batch.leather.flay.name : 'N/A' }}
        </td>
    </tr>
</table>
<br><br><br>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Scheda Partita 005552</title>
    <style>
        @page {
            size: A4;
            margin: 1cm;
        }
        body {
            font-family: 'Arial', sans-serif;
            font-size: 10pt;
            line-height: 1.3;
            color: #333;
            text-transform: uppercase;
        }
        .main-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        .main-table td {
            border: 1px solid #000;
            padding: 4px;
            vertical-align: top;
        }
        .label {
            display: none;
        }
        .value {
            font-size: 14pt;
            font-weight: bold;
        }
        .value-small {
            font-size: 10pt;
            font-weight: bold;
        }
        .header-title {
            text-align: center;
            font-weight: bold;
            font-size: 14pt;
            padding: 10px !important;
        }
        .footer {
            margin-top: 30px;
            font-size: 8pt;
            text-align: right;
            border-top: 1px solid #eee;
            padding-top: 5px;
        }
        .text-center {
            text-align: center;
        }
        .text-right {
            text-align: right;
        }
    </style>
</head>
<body>
    <table class="main-table" style="border: none; margin-bottom: 10px;">
        <tr>
            <td style="width: 25%; text-align: center; border: 1px solid #000;">
                TREEMME
            </td>
            <td style="width: 25%; text-align: center; border: 1px solid #000;">
                SISTEMA QUALITA'
            </td>

            <td style="width: 25%; text-align: center; font-size: 8pt; border: 1px solid #000;">
                MOD. LOTTO
            </td>
            <td style="width: 25%; text-align: center; font-size: 8pt; border: 1px solid #000;">
                REV 2.0
            </td>
        </tr>
    </table>

    {% for data in batch.batchData %}
    <table class="main-table">
        <tr>
            <td colspan="4">
                <table style="width: 100%; border-collapse: collapse; border: none;">
                    <tr>
                        <td style="width: 33%; border: none; padding: 0;">
                            <span class="label">cod. partita</span>
                            <span class="value">{{ batch.batchCode }}</span>
                        </td>
                        <td style="width: 33%; border: none; padding: 0; border-left: 1px solid #000; padding-left: 8px;">
                            <span class="label">Data</span>
                            <span class="value">{{ batch.batchDate ? batch.batchDate|date('d/m/Y') : '-' }}</span>
                        </td>
                        <td style="width: 34%; border: none; padding: 0; border-left: 1px solid #000; padding-left: 8px;">
                            <span class="label">n. pezzi</span>
                            <span class="value">{{ batch.pieces }}</span>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <span class="label">Nome Pellame</span>
                <span class="value">
                    {% if batch.leather %}
                        {{ batch.leather.name }}
                    {% else %}
                        -
                    {% endif %}
                </span>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <span class="label">Scortico pellame</span>
                <span class="value">

                    {% if batch.leather and batch.leather.flay %}
                        SCORTICO {{ batch.leather.flay.name }}
                    {% else %}
                        -
                    {% endif %}
                </span>
            </td>
        </tr>
        <tr>
            <td style="width: 25%;">
                <span class="label">kg lordi previsti</span>
                <span class="value-small">{{ data.foundedGrossWeight ? data.foundedGrossWeight|number_format(2, ',', '.') : (data.declaredGrossWeight ? (data.declaredGrossWeight|number_format(2, ',', '.') : '-')) }}</span>
            </td>
            <td style="width: 25%;">
                <span class="label">n. pallet</span>
                <span class="value-small">{{ data.palletNumber|default('-') }}</span>
            </td>
            <td style="width: 25%;">
                <span class="label">tara</span>
                <span class="value-small">{{ data.palletWeight ? data.palletWeight|number_format(2, ',', '.') : '-' }}</span>
            </td>
            <td style="width: 25%;">
                <span class="label">kg netti</span>
                <span class="value-small">{{ data.foundedNetWeight ? data.foundedNetWeight|number_format(2, ',', '.') : (data.declaredNetWeight ? (data.declaredNetWeight|number_format(2, ',', '.') : '-'))  }}</span>
            </td>
        </tr>
        <tr>
            <td colspan="2" style="width: 50%;">
                <span class="label">porto</span>
                <span class="value"> PORTO {{ data.seaPort ? data.seaPort.name : '-' }}</span>
            </td>
            <td colspan="2" style="width: 50%;">
                <span class="label">data</span>
                <span class="value">DATA {{ data.deliveryDate ? data.deliveryDate|date('d/m/Y') : '-' }}</span>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <span class="label">cod. container</span>
                <span class="value"> CNTN {{ data.containerCode|default('-') }}</span>
            </td>
        </tr>
        <tr>
            <td colspan="2" style="width: 50%;">
                <span class="label">vettore</span>
                <span class="value">VETTORE {{ data.shipmentSubcontractor ? data.shipmentSubcontractor.name : '-' }}</span>
            </td>
            <td colspan="2" style="width: 50%;">
                <span class="label">resa</span>
                <span class="value">RESA {{ data.shipmentCondition ? data.shipmentCondition.name : '-' }}</span>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <span class="label">data pagamento</span>
                <span class="value">DATA PAGAMENTO  {{ data.paymentDate ? data.paymentDate|date('d/m/Y') : '-' }}</span>
            </td>
        </tr>
    </table>
    {% if not loop.last %}
        <div style="page-break-after: always;"></div>
    {% endif %}
    {% else %}
    <table class="main-table">
        <tr>
            <td colspan="4">
                <table style="width: 100%; border-collapse: collapse; border: none;">
                    <tr>
                        <td style="width: 33%; border: none; padding: 0;">
                            <span class="label">cod. partita</span>
                            <span class="value">{{ batch.batchCode }}</span>
                        </td>
                        <td style="width: 33%; border: none; padding: 0; border-left: 1px solid #000; padding-left: 8px;">
                            <span class="label">Data</span>
                            <span class="value">{{ batch.batchDate ? batch.batchDate|date('d/m/Y') : '-' }}</span>
                        </td>
                        <td style="width: 34%; border: none; padding: 0; border-left: 1px solid #000; padding-left: 8px;">
                            <span class="label">n. pezzi</span>
                            <span class="value">{{ batch.pieces }}</span>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td colspan="4" class="text-center">
                <span class="label">Nome Pellame</span>
                <span class="value">
                    {% if batch.article %}
                        {{ batch.article.name }}
                    {% elseif batch.leather %}
                        {{ batch.leather.name }}
                    {% else %}
                        -
                    {% endif %}
                </span>
            </td>
        </tr>
        <tr>
            <td colspan="4" class="text-center" style="font-style: italic;">
                Nessun dato logistico disponibile
            </td>
        </tr>
    </table>
    {% endfor %}

</body>
</html>
